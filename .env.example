# Required — Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-key-here
AZURE_OPENAI_DEPLOYMENT=gpt-5-nano
AZURE_OPENAI_API_VERSION=2024-10-21

# Optional — Embeddings (for hybrid retrieval; falls back to keyword-only)
AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-small

# Required — API authentication
POC_API_KEY=your-api-key-here

# Optional — Observability (omit to disable App Insights)
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Optional — Rate limiting (default: 30 requests per minute per API key)
RATE_LIMIT_RPM=30
